---
interface Props {
  class?: string;
  variant?: 'header' | 'footer';
}

const { class: className, variant = 'header' } = Astro.props;
const label = 'Valorant Cheats';
---

<a
  href="/"
  class:list={['brand-logo', variant === 'footer' && 'brand-logo--footer', className]}
>
  <span class="brand-logo__icon" aria-hidden="true">
    <img
      src="/LOGO-cropped.webp"
      alt=""
      width="36"
      height="36"
      class="brand-logo__img"
      decoding="async"
    />
  </span>
  <span class="brand-logo__text">{label}</span>
</a>

<style>
  .brand-logo {
    --brand-logo-icon: 2.25rem;
    position: relative;
    display: inline-flex;
    align-items: center;
    overflow: hidden;
    height: var(--brand-logo-icon);
    max-width: var(--brand-logo-icon);
    border-radius: 0.5rem;
    transition:
      max-width 0.35s ease,
      box-shadow 0.2s ease;
  }

  .brand-logo--footer {
    --brand-logo-icon: 2rem;
  }

  .brand-logo:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .brand-logo__img {
    width: var(--brand-logo-icon);
    height: var(--brand-logo-icon);
    object-fit: cover;
    object-position: center;
    transform: scale(1.22);
    border-radius: 0.375rem;
  }

  .brand-logo__icon {
    position: absolute;
    right: 0;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--brand-logo-icon);
    height: var(--brand-logo-icon);
    z-index: 1;
    transition: transform 0.35s ease;
  }

  .brand-logo__text {
    display: flex;
    align-items: center;
    height: var(--brand-logo-icon);
    padding-inline: 0.5rem calc(var(--brand-logo-icon) + 0.25rem);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--foreground);
  }

  .brand-logo:hover,
  .brand-logo:focus-within {
    max-width: 14rem;
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--border) 80%, transparent);
  }

  .brand-logo:hover .brand-logo__icon,
  .brand-logo:focus-within .brand-logo__icon {
    transform: translateX(calc(100% + 0.25rem));
  }
</style>
